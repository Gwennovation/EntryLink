PORT=4000
# Leave unset to use embedded PGlite (stored in apps/api/.data/pglite)
# DATABASE_URL=postgres://user:pass@localhost:5432/entrylink
# Required in production — generate with: openssl rand -base64 48
JWT_SECRET=
QR_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated list, or * for any origin (dev only)
CORS_ORIGINS=*
# Link encoded in event poster QR codes. Phones can't open localhost — for on-phone testing use
# http://<your-Mac's-Wi-Fi-IP>:5173, in production your real web domain.
PUBLIC_WEB_URL=http://localhost:5173
# Leave unset until an email transport is implemented in src/services/email.js.
# EMAIL_PROVIDER=
