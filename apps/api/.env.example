PORT=4000
# Leave unset to use embedded PGlite (stored in apps/api/.data/pglite)
# DATABASE_URL=postgres://user:pass@localhost:5432/entrylink
# Required in production — generate with: openssl rand -base64 48
JWT_SECRET=
QR_SECRET=
# How long a sign-in lasts
SESSION_HOURS=12
# Comma-separated list of web origins allowed to call the API. * is only accepted outside
# production; the API refuses to start in production without an explicit list.
CORS_ORIGINS=*
# Set to 1 when the API runs behind one reverse proxy (Render, Railway, Nginx) so rate limits see
# real client IPs. Leave unset when clients connect directly, or they could spoof their IP.
# TRUST_PROXY=1
# Session cookies are HTTPS-only in production automatically; force it elsewhere with:
# COOKIE_SECURE=true
# Link encoded in event poster QR codes. Phones can't open localhost — for on-phone testing use
# http://<your-Mac's-Wi-Fi-IP>:5173, in production your real web domain.
PUBLIC_WEB_URL=http://localhost:5173
# Leave unset until an email transport is implemented in src/services/email.js.
# EMAIL_PROVIDER=
# Create the demo accounts/events on first start if the database is empty (runs once)
# SEED_DEMO=true
# Private Vercel Blob store for receipts: set automatically when you connect one on Vercel.
# Unset = receipts are stored on local disk (UPLOAD_DIR).
# BLOB_STORE_ID=
