PORT=4000
# Leave unset to use embedded PGlite (stored in apps/api/.data/pglite)
# DATABASE_URL=postgres://user:pass@localhost:5432/entrylink
# Required in production — generate with: openssl rand -base64 48
JWT_SECRET=
QR_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated list, or * for any origin (dev only)
CORS_ORIGINS=*
